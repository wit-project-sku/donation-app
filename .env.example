# Donation CMS API (campaigns, history, certificate save). Empty = same-origin + Vite proxy in dev.
VITE_USE_MOCK_API=false
VITE_PUBLIC_APP_URL=
VITE_API_BASE_URL=

# Kiosk payment terminal API (default: local payment server)
VITE_PAYMENT_API_BASE_URL=http://127.0.0.1:8080

# AI outfit/photo processing API
VITE_AR_PROCESS_API_URL=https://kr-ar-api.digicon.pro/api/v2/process_and_combine
VITE_AR_PROCESS_IMAGE_API_URL=https://kr-kiosk.digicon.pro/api/v2/process_image

# Vite dev proxy target when VITE_API_BASE_URL is empty
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
